Bootstrap: docker
From: ubuntu:24.04

%labels
    Author Isaac Martinez Ugalde
    Version v1.1
    Description sRNAseq-nf apptainer image (no conda; custom Python resolver)

%environment
    export PATH=/usr/local/bin:/root/.local/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export HOME=/root

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export HOME=/root
    mkdir -p /root
    cd /

    # Core OS + bio tools
    apt-get update
    apt-get install -y --no-install-recommends \
        bash ca-certificates curl wget git unzip zstd \
        openjdk-17-jre-headless openjdk-17-jdk-headless \
        python3 python3-venv python3-pip pipx \
        r-base r-base-dev \
        build-essential pkg-config autoconf automake libtool cmake \
        libcurl4-openssl-dev libxml2-dev libssl-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        fastqc cutadapt bowtie bedtools samtools pigz bc gawk \
        zlib1g-dev libpcre3-dev liblzma-dev libbz2-dev \
        libgsl-dev libmpfr-dev libgmp-dev bison flex \
        python3-pysam python3-tqdm \
        locales && \
    rm -rf /var/lib/apt/lists/*


    # Make "python" available
    ln -sf /usr/bin/python3 /usr/local/bin/python

    # MultiQC via pipx (isolated venv on PATH)
    pipx install multiqc
    ln -sf /root/.local/bin/multiqc /usr/local/bin/multiqc

    # pullseq (CMake build) — copy binaries manually
    rm -rf /tmp/pullseq
    git clone --depth 1 https://github.com/bcthomas/pullseq /tmp/pullseq
    mkdir -p /tmp/pullseq/build
    cd /tmp/pullseq/build
    cmake ..
    make -j"$(nproc)"
    find . -type f -executable -name 'pullseq' -exec cp {} /usr/local/bin/ \;
    find . -type f -executable -name 'seqdiff' -exec cp {} /usr/local/bin/ \;
    cd /
    rm -rf /tmp/pullseq

    # R + Bioconductor packages
    R -q -e "install.packages('BiocManager', repos='https://cloud.r-project.org')"
    R -q -e "options(Ncpus=2); BiocManager::install(c('Rsubread','rtracklayer','edgeR','plyranges','Rsamtools'), ask=FALSE, update=FALSE)"
    R -q -e "install.packages(c('pacman','ggplot2','ggpubr','dplyr','purrr','gplots','optparse','reshape','reshape2','kableExtra','ggbreak','stringr','pals','stringi','scales','tidyr','tibble'), repos='https://cloud.r-project.org')"

    # Nextflow
    apt-get update && apt-get install -y wget openjdk-17-jdk-headless
    wget -qO- https://get.nextflow.io | bash
    chmod +x nextflow
    mv nextflow /usr/local/bin/
    rm -rf /var/lib/apt/lists/*
    

    # Pre-cache the exact framework jar so the launcher never curls at runtime
    NF_VER=25.04.6
    mkdir -p /opt/nextflow/framework/${NF_VER}
    curl -L -o /opt/nextflow/framework/${NF_VER}/nextflow-${NF_VER}-one.jar \
      "https://www.nextflow.io/releases/v${NF_VER}/nextflow-${NF_VER}-one.jar"

    # nf-test
    curl -fsSL https://get.nf-test.com | bash
    install -m 0755 nf-test /usr/local/bin/nf-test
    chmod +x /usr/local/bin/nf-test

    # Provide a writable fallback cache inside image (you may still bind one over it)
    mkdir -p /root/.nextflow
    chmod 777 /root/.nextflow 

%test
    set -e
    which nextflow
    nextflow -version || true
    which nf-test
    nf-test --version || true
    fastqc --version || true
    bowtie --version || true
    multiqc --version || true
    python - <<'PY'
import sys; import pysam, tqdm
print("python ok:", sys.version)
print("pysam:", pysam.__version__)
print("tqdm:", tqdm.__version__)
PY
    R -q -e "cat('R ok\n')"

%runscript
    exec nextflow "$@"
