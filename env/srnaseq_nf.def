Bootstrap: docker
From: continuumio/miniconda3:latest

%labels
    Author Isaac Martinez Ugalde
    About "Conda env (srnaseq_nf) + compiled collapse.c (conda-only)"

%environment
    export CONDA_DIR=/opt/conda
    export CONDA_DEFAULT_ENV=srnaseq_nf
    export PATH="$CONDA_DIR/envs/$CONDA_DEFAULT_ENV/bin:$CONDA_DIR/bin:$PATH"
    export LD_LIBRARY_PATH="$CONDA_DIR/envs/$CONDA_DEFAULT_ENV/lib:${LD_LIBRARY_PATH:-}"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export HOME=/root

%setup
    if [ -n "${APPTAINER_BUILD_SOURCE:-}" ] && [ -d "${APPTAINER_BUILD_SOURCE:-}" ]; then DEF_DIR="${APPTAINER_BUILD_SOURCE}"; else DEF_DIR="$(pwd)"; fi
    if command -v readlink >/dev/null 2>&1; then SRC_DIR="$(readlink -f "$DEF_DIR/../bin")"; else SRC_DIR="$DEF_DIR/../bin"; fi
    mkdir -p "$APPTAINER_ROOTFS/opt/srnanf"
    for f in collapse.c kseq.h khash.h; do
        if [ -f "$SRC_DIR/$f" ]; then cp "$SRC_DIR/$f" "$APPTAINER_ROOTFS/opt/srnanf/$f"; else echo "missing $SRC_DIR/$f" >&2; exit 1; fi
    done

%post

    conda create -y -n srnaseq_nf -c conda-forge -c bioconda -c defaults \
      c-compiler cxx-compiler make zlib jq r-curl \
      pip bowtie pigz bc cutadapt fastqc multiqc bedtools fastp \
      samtools pullseq gawk \
      openjdk=17 nextflow nf-test pysam tqdm numba \
      r-base=4.4 bioconductor-rsubread bioconductor-rtracklayer \
      bioconductor-edger bioconductor-plyranges bioconductor-rsamtools \
      r-pacman r-ggplot2 r-ggpubr r-dplyr r-purrr r-gplots r-optparse \
      r-reshape r-reshape2 r-kableextra r-ggbreak r-stringr r-pals \
      r-stringi r-scales r-tidyr r-tibble

    if [ -s /opt/srnanf/collapse.c ]; then
        cat >/tmp/build_collapse.sh <<'BASH'

CONDA_PREFIX="${CONDA_PREFIX:-/opt/conda/envs/srnaseq_nf}"
OUT="$CONDA_PREFIX/bin/collapse"
CCBIN="${CC:-}"
[ -z "$CCBIN" ] && CCBIN="$(command -v x86_64-conda-linux-gnu-cc || true)"
[ -z "$CCBIN" ] && CCBIN="$(command -v gcc || true)"
[ -z "$CCBIN" ] && CCBIN="$(command -v cc || true)"
[ -z "$CCBIN" ] && { echo "no compiler" >&2; exit 1; }
CFLAGS="-O3 -std=c11 -Wall -Wextra -D_POSIX_C_SOURCE=200809L -I/opt/srnanf -I${CONDA_PREFIX}/include"
LDFLAGS="-L${CONDA_PREFIX}/lib -Wl,-rpath,${CONDA_PREFIX}/lib -lz"
"$CCBIN" $CFLAGS -include string.h /opt/srnanf/collapse.c -o "$OUT" $LDFLAGS
chmod +x "$OUT"
mkdir -p /usr/local/bin
ln -sf "$OUT" /usr/local/bin/collapse
BASH
        chmod +x /tmp/build_collapse.sh
        conda run -n srnaseq_nf bash /tmp/build_collapse.sh
    else
        echo "/opt/srnanf/collapse.c not found" >&2; exit 1
    fi

    conda clean -afy

%test
    
    for tool in collapse fastqc fastp bedtools samtools cutadapt bowtie multiqc nextflow; do
        command -v "$tool" >/dev/null 2>&1 || { echo "Missing $tool"; exit 1; }
    done
    python - <<'PY'
import sys, pysam, tqdm, numba
print("Python", sys.version.split()[0])
print("pysam", pysam.__version__)
print("tqdm", tqdm.__version__)
print("numba", numba.__version__)
PY
    Rscript -e 'suppressPackageStartupMessages(library(edgeR)); print(paste("R ok:", as.character(getRversion())))'
