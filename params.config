params {
  reads       = "/path/to/sirmap/fastq/*.fastq.gz"
  threads     = 4
  adapter     = "AGATCGGAAGAG"
  minlen      = 18
  maxlen      = 27
  genome      = "/path/to/sirmap/example/genome/caenorhabditis_elegans.PRJNA13758.WBPS19.genomic.fa"
  annotation  = "/path/to/sirmap/example/annotation/caenorhabditis_elegans.PRJNA13758.WBP19.overlapping_annotation.gff3"
  offrate_sm  = 4       
  thr_sm      = 12      
  smem_sm     = "12G"   
  assign_mode = 'uwm'
  wins_sm     = 200  
  minoverlap  = 0.7
  contrast    = "/path/to/sirmap/contrast.txt"
  lfc         = 2
  fdr         = 0.01
  hk_norm     = true
  norm_feature = "miRNA_S"
  stringent_tmm = false
  first_nt    = "T"
  apply_first_nt_downstream = true
}
